<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A mouse and a keyboard are welcome, a touchscreen is not required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".GliffApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gliff">

        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true">
            <!-- On a desktop, the system offers to open the list in another window. -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            No orientation, no aspect ratio: the window is whatever the user
            makes it. configChanges keeps the activity (and the video surface)
            through a resize, a rotation, a move to another display or a
            keyboard being plugged in; without it each of those would recreate
            the activity. documentLaunchMode gives each machine its own task.
            adjustResize reports the on-screen keyboard as an inset, which the
            screen uses to keep the picture above it.
        -->
        <activity
            android:name=".SessionActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
    </application>
</manifest>
